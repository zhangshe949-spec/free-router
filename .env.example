# free-router 密钥模板：复制为 .env 后填写。
# 所有 key 均可留空 —— 留空的提供商会被自动跳过，不影响其他提供商工作。
# 优先级：环境变量 > ./.env > ~/.free-router/.env

# AMD Radeon（developer.amd.com.cn，每日额度，自动恢复）
RADEON_API_KEY=

# 魔搭 ModelScope（modelscope.cn，每日额度）
MODELSCOPE_API_KEY=

# Kilo（api.kilo.ai，免费池多模型）
KILO_API_KEY=

# 智谱 / 硅基流动 等（可选）
ZHIPU_API_KEY=
SILICONFLOW_API_KEY=
