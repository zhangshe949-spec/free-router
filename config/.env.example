# 复制为 .env 并填写真实密钥
# AMD Radeon（国内直连，rc- 开头）
AMD_API_KEY=rc-xxxx

# ModelScope 魔塔（三工具各自独立 key）
MODELSCOPE_API_KEY=sk-xxxx

# Kilo 网关（免 key，留空即可）
KILOGW_API_KEY=

# ===== Phase 1 新增：7 家国内免费提供商（全部从环境变量读取，config.yaml 留空）=====
ZAI_API_KEY=              # 智谱 GLM
SILICONFLOW_API_KEY=      # 硅基流动
QIANFAN_API_KEY=          # 百度千帆
HUNYUAN_API_KEY=          # 腾讯混元
SPARK_API_KEY=            # 讯飞星火
DASHSCOPE_API_KEY=        # 阿里云百炼
ARK_API_KEY=              # 火山方舟

# 可选：api_key 以 'enc:' 前缀书写时的 AES-GCM 解密口令
# FREE_ROUTER_ENC_KEY=change-me

